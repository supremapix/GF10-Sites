{
  "name": "gf10-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "npm run typecheck && npm run lint && node scripts/build.mjs && npm test",
    "assets": "node scripts/assets.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
