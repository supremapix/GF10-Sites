    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "cheerio": "^1.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0"
  }
